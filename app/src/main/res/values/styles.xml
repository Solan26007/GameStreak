<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppChip.Dark" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">999dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="checkedIconEnabled">false</item>
    </style>

    <!--
        IMPORTANTE:
        MaterialButton maneja su propio background.
        Si se sobreescribe con android:background y además se usan attrs de forma (cornerRadius/stroke),
        puede disparar IllegalStateException (background overwritten) al inflar el layout.
        Aquí dejamos el look (drawables) pero desactivamos el tint del MaterialButton y quitamos attrs de forma.
    -->
    <style name="AppButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_primary_gradient</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- cornerRadius lo controla el drawable (bg_button_primary_gradient.xml) -->
    </style>

    <style name="AppButton.Outline" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <!-- stroke/cornerRadius los controla el drawable (bg_button_outline.xml) -->
    </style>
</resources>
