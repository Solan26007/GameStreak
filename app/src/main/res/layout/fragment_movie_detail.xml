<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollMovieDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030213"
    android:padding="16dp"
    tools:context=".ui.detalle.DetallePeliculaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgPosterBig"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:contentDescription="@string/poster_big_desc"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/txtMovieTitleDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/movie_title_placeholder"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtMovieMetaDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/movie_meta_placeholder"
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtMoviePlatformsDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/movie_platforms_placeholder"
            android:textColor="#FACC15"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtSectionSynopsis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_synopsis"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtMovieSynopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/movie_synopsis_placeholder"
            android:textColor="#D1D5DB"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtSectionTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_tags"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacing="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTag1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="@string/tag_fun" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTag2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="@string/tag_light" />

        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToWatchlist"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/watchlist_button_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDislike"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/dislike_button_label" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
