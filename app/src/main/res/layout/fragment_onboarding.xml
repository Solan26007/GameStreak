<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollOnboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:padding="16dp"
    tools:context=".ui.onboarding.OnboardingFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- “Hero” superior -->
        <TextView
            android:id="@+id/txtWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtWelcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Géneros -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_genres_label"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_section_card"
            android:padding="12dp">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkAccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/genre_action"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkComedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/genre_comedy"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkDrama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/genre_drama"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkTerror"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/genre_horror"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkScifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/genre_scifi"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkRomance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/genre_romance"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />
        </LinearLayout>

        <!-- Plataformas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_platforms_label"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutPlatforms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_section_card"
            android:padding="12dp">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkPc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/platform_netflix"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkPlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/platform_prime"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkXbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/platform_disney"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/platform_hbo"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkMobile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/platform_apple"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />
        </LinearLayout>

        <!-- Cosas a evitar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_avoid_label"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutAvoid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_section_card"
            android:padding="12dp">

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkMicro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avoid_violence"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkGrindeo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avoid_gore"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkLargos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avoid_slow_movies"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />

            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/checkDificultad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avoid_sad_endings"
                android:textColor="@color/text_primary"
                android:buttonTint="@color/accent_cyan" />
        </LinearLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipOnboarding"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_skip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinishOnboarding"
                style="@style/AppButton.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_continue"
                android:textAllCaps="false"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
