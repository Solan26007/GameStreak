<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollGroupMode"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030213"
    android:padding="16dp"
    tools:context=".ui.modogrupo.ModoGrupoFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modo grupo"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtGroupSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crea una sala, comparte el código con tus amigos y voten juntos por la película perfecta."
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateRoom"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear sala" />

        <TextView
            android:id="@+id/txtOr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="o"
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/editRoomCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Código de sala"
            android:inputType="text"
            android:textColor="@android:color/white"
            android:textColorHint="#6B7280"
            android:background="@android:drawable/edit_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoinRoom"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unirse a sala"
            android:layout_marginTop="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1F2933"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/txtGroupResultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resultado de la sala"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtGroupResultInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aquí se mostrará la película ganadora cuando termine la votación."
            android:textColor="#9CA3AF"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>
