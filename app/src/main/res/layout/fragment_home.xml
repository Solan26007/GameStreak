<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".ui.inicio.InicioFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <com.example.moviematch.ui.common.GradientTextView
            android:id="@+id/txtHomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtHomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_time_label"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime30"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_time_30" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime60"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_time_60" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime90"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_time_90" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime120"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_time_120" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_mood_label"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodRelax"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_mood_relax" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodRisa"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_mood_laugh" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodPensar"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_mood_think" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodSusto"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_mood_scare" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_company_label"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSolo"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_company_solo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPareja"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_company_couple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAmigos"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_company_friends" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFamilia"
                style="@style/AppChip.Dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_company_family" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarPelicula"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/home_search_button"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModoGrupo"
            style="@style/AppButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_group_mode_button"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
